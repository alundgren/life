# Path to the SQLite database file. Created (with parent directories) on first run.
SQLITE_DB_PATH=./data/life.db

# Base URL of the local Ollama instance the Planner calls.
OLLAMA_HOST=http://localhost:11434

# Ollama model the Planner asks for.
OLLAMA_MODEL=qwen2.5:3b

# The deployment-wide IANA timezone used for all calendar dates and displayed instants.
APP_TIME_ZONE=Europe/Stockholm

# Set to true only in development to freeze the app's clock and advance it from Settings.
SIMULATED_CLOCK=false
